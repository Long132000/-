if 'owners' in df.columns:
    def skolko_kupili(x):
        try:
            if '-' in str(x):
                a, b = str(x).split('-')
                return (float(a) + float(b)) / 2
        except:
            pass
        return 0
    
    df['vladelcy'] = df['owners'].apply(skolko_kupili)
    top6 = df.nlargest(6, 'vladelcy')[['name', 'vladelcy', 'price']]
    
    print('\nтоп 6 по покпкам:')

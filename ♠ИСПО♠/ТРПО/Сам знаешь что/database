import sqlite3
from datetime import date

DB_NAME = 'bank.db'

def get_connection():
    """Возвращает соединение с базой данных"""
    return sqlite3.connect(DB_NAME)

def init_db():
    """Создаёт таблицы, если их нет"""
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS clients (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                type TEXT CHECK(type IN ('individual', 'organization')),
                tax_id TEXT UNIQUE,
                phone TEXT
            )
        ''')
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS loans (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                client_id INTEGER NOT NULL,
                amount REAL NOT NULL,
                interest_rate REAL NOT NULL,
                term_months INTEGER NOT NULL,
                status TEXT CHECK(status IN ('одобрен', 'выдан', 'отказан', 'закрыт')),
                status_date TEXT NOT NULL,
                application_date TEXT NOT NULL,
                FOREIGN KEY (client_id) REFERENCES clients(id) ON DELETE CASCADE
            )
        ''')
        conn.commit()

# ========== Функции для работы с клиентами ==========
def add_client(name, client_type, tax_id, phone):
    """Добавляет нового клиента. Возвращает его ID."""
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute('''
            INSERT INTO clients (name, type, tax_id, phone)
            VALUES (?, ?, ?, ?)
        ''', (name, client_type, tax_id, phone))
        conn.commit()
        return cursor.lastrowid

def get_client_by_id(client_id):
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute('SELECT * FROM clients WHERE id = ?', (client_id,))
        return cursor.fetchone()

def get_all_clients():
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute('SELECT id, name, type, tax_id, phone FROM clients')
        return cursor.fetchall()

# ========== Функции для работы с кредитами ==========
def add_loan(client_id, amount, interest_rate, term_months, application_date):
    """Создаёт новую кредитную заявку со статусом 'одобрен'? 
       По условию, заявка сначала создаётся, потом её одобряют. 
       Сделаем начальный статус 'одобрен'? Нет, лучше 'заявка создана', но в задании только 4 статуса.
       Используем 'одобрен' как начальный после проверки, но для демонстрации создадим сразу 'одобрен'.
       Однако для тестирования удобнее создать заявку без статуса? У нас есть только эти 4.
       Будем считать, что при создании кредита он сразу получает статус 'одобрен' (условно).
    """
    status = 'одобрен'
    status_date = application_date  # в день подачи
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute('''
            INSERT INTO loans (client_id, amount, interest_rate, term_months, status, status_date, application_date)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        ''', (client_id, amount, interest_rate, term_months, status, status_date, application_date))
        conn.commit()
        return cursor.lastrowid

def update_loan_status(loan_id, new_status, change_date):
    """Обновляет статус кредита и дату статуса."""
    if new_status not in ('одобрен', 'выдан', 'отказан', 'закрыт'):
        raise ValueError('Недопустимый статус')
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute('''
            UPDATE loans SET status = ?, status_date = ? WHERE id = ?
        ''', (new_status, change_date, loan_id))
        conn.commit()

def get_loans_by_status_and_interval(status, start_date, end_date):
    """Возвращает кредиты с указанным статусом, у которых status_date в интервале [start_date, end_date]."""
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute('''
            SELECT l.id, c.name, l.amount, l.interest_rate, l.term_months, l.status, l.status_date, l.application_date
            FROM loans l
            JOIN clients c ON l.client_id = c.id
            WHERE l.status = ? AND l.status_date BETWEEN ? AND ?
            ORDER BY l.status_date
        ''', (status, start_date, end_date))
        return cursor.fetchall()

def get_all_loans_for_client(client_id):
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute('SELECT * FROM loans WHERE client_id = ?', (client_id,))
        return cursor.fetchall()

{"S","ВЫБРАТЬ
	Номенклатура.Ссылка КАК Ссылка,
	Номенклатура.ВерсияДанных КАК ВерсияДанных,
	Номенклатура.ПометкаУдаления КАК ПометкаУдаления,
	Номенклатура.Родитель КАК Родитель,
	Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
	Номенклатура.Код КАК Код,
	Номенклатура.Наименование КАК Наименование,
	Номенклатура.Артикул КАК Артикул,
	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	Номенклатура.ЦенаЗакупки КАК ЦенаЗакупки,
	Номенклатура.ЦенаПродажи КАК ЦенаПродажи,
	Номенклатура.СтавкаНДС КАК СтавкаНДС,
	Номенклатура.ОсновнойПоставщик КАК ОсновнойПоставщик,
	Номенклатура.СтранаПроисхождения КАК СтранаПроисхождения,
	Номенклатура.ЭтоНовинка КАК ЭтоНовинка,
	Номенклатура.ЭтоНовинкаДоДаты КАК ЭтоНовинкаДоДаты,
	Номенклатура.Описание КАК Описание,
	Номенклатура.Предопределенный КАК Предопределенный,
	Номенклатура.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
ИЗ
	Справочник.Номенклатура КАК Номенклатура
ГДЕ
	Номенклатура.ЭтоГруппа = ЛОЖЬ
	И Номенклатура.ЦенаПродажи МЕЖДУ 80 И 200
	И Номенклатура.Наименование ПОДОБНО ""%а%"""},
